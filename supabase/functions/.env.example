# Secrets for the Supabase Edge Functions (extract-article, generate-digest,
# process-queue). Copy to supabase/functions/.env for `supabase functions serve`,
# or push to the hosted project with:
#   supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by the
# Supabase runtime and must not be set here.

# Required
OPENROUTER_API_KEY=<openrouter-api-key>   # Claude via OpenRouter (article analysis, digests)
JINA_API_KEY=<jina-api-key>               # Jina Reader fallback extraction
XAI_API_KEY=<xai-api-key>                 # Grok, X/Twitter post extraction

# Optional
TAVILY_API_KEY=<tavily-api-key>           # Search enrichment
UNSPLASH_ACCESS_KEY=<unsplash-access-key> # Fallback cover images

# Model ids (defaults shown; override without redeploying)
CLAUDE_MODEL=anthropic/claude-haiku-4.5   # OpenRouter slug
GROK_MODEL=grok-4-1-fast                  # xAI model id
